rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // --- Helper Functions ---
    function isAuthenticated() {
      return request.auth != null;
    }

    function getUserEmail() {
      return request.auth.token.email != null ? request.auth.token.email.lower() : '';
    }

    // Approved team emails: @studiotunnel.com domain + approved personal email whitelist
    function isApprovedUser() {
      return isAuthenticated() && (
        getUserEmail().matches('.*@studiotunnel[.]com$') ||
        getUserEmail() in [
          'samiran@studiotunnel.com',
          'yash@studiotunnel.com',
          'sujith@studiotunnel.com',
          'contactmanojsahu@gmail.com',
          'manoj@studiotunnel.com',
          'tamashansari4@gmail.com',
          'tamash@studiotunnel.com',
          'prakashjai.tunnel@gmail.com',
          'prakash@studiotunnel.com',
          'arjunkohli@gmail.com',
          'arjun@studiotunnel.com',
          'ayushdalvi@gmail.com',
          'ayush@studiotunnel.com',
          'vijaynool@gmail.com',
          'vijay@studiotunnel.com',
          'golu@studiotunnel.com',
          'golu.tunnel@gmail.com',
          'aaditya@studiotunnel.com',
          'aaditya.tunnel@gmail.com',
          'lab@studiotunnel.com'
        ]
      );
    }

    // Master Studio Administrators
    function isAdmin() {
      return isAuthenticated() && (
        getUserEmail() in [
          'samiran@studiotunnel.com',
          'yash@studiotunnel.com',
          'lab@studiotunnel.com'
        ]
      );
    }


    // Executive & Line Production leadership roles
    function isManagementOrProducer() {
      return isAdmin() || (
        getUserEmail() in [
          'tamash@studiotunnel.com',
          'tamashansari4@gmail.com',
          'prakash@studiotunnel.com',
          'prakashjai.tunnel@gmail.com'
        ]
      );
    }


    // --- Data Collections (Scoped to artifacts hierarchy) ---
    match /artifacts/{appId}/public/data {
      
      // User Profiles (Read allowed for team, write strictly to owner/management)
      match /user_profiles/{docId} {
        allow read: if isApprovedUser();
        allow write: if isApprovedUser() && (isManagementOrProducer() || request.resource.data.email.lower() == getUserEmail());
      }

      // Live Presence status & Clock-in
      match /presence/{docId} {
        allow read, write: if isApprovedUser();
      }

      // Projects & Bookings (Accessible only by approved team members)
      match /projects/{docId} {
        allow read: if isApprovedUser();
        allow create, update: if isApprovedUser();
        allow delete: if isManagementOrProducer();
      }

      match /bookings/{docId} {
        allow read: if isApprovedUser();
        allow create, update: if isApprovedUser();
        allow delete: if isManagementOrProducer();
      }

      // Tasks
      match /tasks/{docId} {
        allow read, write: if isApprovedUser();
      }

      // Attendance & Leaves (Only Management/Producers can approve/reject leaves)
      match /leaves/{docId} {
        allow read: if isApprovedUser();
        allow create: if isApprovedUser();
        allow update: if isApprovedUser() && (isManagementOrProducer() || resource.data.userId == request.auth.uid);
        allow delete: if isManagementOrProducer();
      }

      // Shift logs
      match /shift_logs/{docId} {
        allow read, create, update: if isApprovedUser();
        allow delete: if isManagementOrProducer();
      }

      // Submissions (QC & Approval restricted to management/leads)
      match /submissions/{docId} {
        allow read, create: if isApprovedUser();
        allow update: if isApprovedUser();
        allow delete: if isManagementOrProducer();
      }

      // Team Chat Messages
      match /messages/{docId} {
        allow read, create: if isApprovedUser();
        allow update, delete: if isManagementOrProducer() || (isApprovedUser() && resource.data.senderId == request.auth.uid);
      }

      // Notepads, Long Format Logs & WA Templates
      match /notepads/{docId} {
        allow read, write: if isApprovedUser();
      }

      match /long_format_logs/{docId} {
        allow read, write: if isApprovedUser();
      }

      match /wa_templates/{docId} {
        allow read: if isApprovedUser();
        allow write: if isManagementOrProducer();
      }
    }

    // Default deny all other paths
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
