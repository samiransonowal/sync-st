/**
 * ST-IN-gen PDF Generation Module
 * Generates vector PDF invoices from HTMLTemplate.html and dispatches via Drive & MailApp.
 */

/**
 * Main function to generate an invoice PDF.
 * @param {Object} invoiceData - The JSON payload containing invoice details.
 * @param {String} targetFolderId - The Google Drive folder ID to save the PDF.
 * @returns {Object} { url: String, blob: Blob, fileId: String }
 */
function generateInvoicePdf(invoiceData, targetFolderId) {
  let template;
  try {
    // 1. Attempt to load HTMLTemplate from Apps Script sidebar
    template = HtmlService.createTemplateFromFile('HTMLTemplate');
  } catch(e) {
    // 2. Fallback to embedded HTML string template
    Logger.log("HTMLTemplate file not found in Apps Script sidebar, using embedded HTML template fallback.");
    template = HtmlService.createTemplate(getHTMLTemplateString_());
  }
  
  // 3. Inject data into the template
  template.data = invoiceData;
  template.logoDataUri = getLogoBase64_(); 
  template.signatureDataUri = getSignatureBase64_();
  
  // 4. Evaluate template to raw HTML
  const htmlContent = template.evaluate().getContent();
  
  // 5. Convert HTML to Blob (Vector PDF)
  const blob = Utilities.newBlob(htmlContent, MimeType.HTML).getAs(MimeType.PDF);
  const pdfName = `Invoice_${invoiceData.invoice_no.replace(/\//g, '_')}.pdf`;
  blob.setName(pdfName);
  
  // 6. Save to Google Drive
  let folder;
  if (targetFolderId && targetFolderId !== 'root') {
    try {
      folder = DriveApp.getFolderById(targetFolderId);
    } catch(e) {
      folder = DriveApp.getRootFolder();
    }
  } else {
    folder = DriveApp.getRootFolder();
  }
  
  const file = folder.createFile(blob);
  file.setSharing(DriveApp.Access.ANYONE_WITH_LINK, DriveApp.Permission.VIEW);
  
  return {
    url: file.getUrl(),
    blob: file.getAs(MimeType.PDF),
    fileId: file.getId()
  };
}

function getLogoBase64_() {
  return "data:image/png;base64,";
}

function getSignatureBase64_() {
  return "data:image/png;base64,";
}

